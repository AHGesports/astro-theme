---
import Container from "./Container.astro";
import { CONTACT } from "../consts";

const navLinks = [
    { label: "How It Works", href: "/#how-it-works" },
    { label: "Features", href: "/#features" },
    { label: "Use Cases", href: "/#use-cases" },
    { label: "FAQ", href: "/#faq" },
];
---

<footer class="border-t border-gray-100 dark:border-gray-800">
    <Container>
        <div class="py-16">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-12">
                <!-- Brand -->
                <div class="md:w-1/3">
                    <a href="/#home" class="flex items-center space-x-2">
                        <div aria-hidden="true" class="flex space-x-1">
                            <div class="size-4 rounded-full bg-gray-900 dark:bg-white"></div>
                            <div class="h-6 w-2 bg-primary"></div>
                        </div>
                        <span class="text-2xl font-bold text-gray-900 dark:text-white">Elyt</span>
                    </a>
                    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xs">
                        AI browser automation at scale. Automate any website across hundreds of profiles without getting detected.
                    </p>
                </div>

                <!-- Navigation -->
                <div>
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Product</h4>
                    <ul class="space-y-3">
                        {navLinks.map((link) => (
                            <li>
                                <a href={link.href} class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition">
                                    {link.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>

                <!-- Connect -->
                <div>
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Connect</h4>
                    <ul class="space-y-3">
                        <li>
                            <a href="https://github.com/AHGesports" target="_blank" rel="noopener" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition flex items-center gap-2">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                                GitHub
                            </a>
                        </li>
                        <li>
                            <a href="https://twitter.com/elyt_ai" target="_blank" rel="noopener" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition flex items-center gap-2">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                                Twitter / X
                            </a>
                        </li>
                        <li>
                            <a href="https://discord.gg/elyt" target="_blank" rel="noopener" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition flex items-center gap-2">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>
                                Discord
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- CTA -->
                <div>
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Get Started</h4>
                    <div class="space-y-3">
                        <button data-contact-modal class="block text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition">
                            Request Access
                        </button>
                        <button
                            data-cal-link={CONTACT.CAL_LINK}
                            data-cal-config='{"theme":"light"}'
                            class="block text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition"
                        >
                            Book a Demo
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-gray-100 dark:border-gray-800 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <span class="text-sm text-gray-400 dark:text-gray-500">
                Elyt &copy; <span id="year"></span>. All rights reserved.
            </span>
            <div class="flex gap-6">
                <a href="#" class="text-sm text-gray-400 dark:text-gray-500 hover:text-primary transition">Privacy Policy</a>
                <a href="#" class="text-sm text-gray-400 dark:text-gray-500 hover:text-primary transition">Terms of Use</a>
            </div>
        </div>
    </Container>
</footer>
