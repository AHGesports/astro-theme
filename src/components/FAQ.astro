---
import Container from "./Container.astro"

const faqs = [
    {
        question: "What is Elyt and how is it different from other AI automation tools?",
        answer: "Elyt is an AI browser automation platform built for scale. Unlike tools like browser-use or Skyvern that control a single browser, Elyt runs automations across hundreds of browser profiles simultaneously — each with unique fingerprints, proxies, and identities. You build workflows in plain English, schedule them, and Elyt's AI humanizer makes every session behave like a real person browsing.",
    },
    {
        question: "Do I need to know how to code?",
        answer: "Not at all. Elyt uses natural language AI — you describe what you want to automate in plain English, and the AI handles the rest. For more complex tasks, you can use the visual workflow builder to chain multiple steps together with drag-and-drop nodes. No coding, no CSS selectors, no XPaths.",
    },
    {
        question: "Which anti-detect browsers does Elyt support?",
        answer: "Elyt integrates with AdsPower, MoreLogin, GoLogin, and many more providers — including custom CDP connections to custom solutions. You connect your existing browser account, and Elyt orchestrates your profiles through their APIs.",
    },
    {
        question: "How does Elyt make automation more reliable?",
        answer: "Elyt's AI humanizer generates realistic mouse movements, natural typing rhythms, random scroll patterns, and human-like pauses. This means your automated sessions behave like real browsing — so they run longer, work more consistently, and interact with websites the way a person would.",
    },
    {
        question: "What AI models can I use?",
        answer: "Elyt supports 10+ AI model providers including OpenAI (GPT), Anthropic (Claude), Google (Gemini), Groq, and even local models through Ollama. You can bring your own API keys and switch between models per task to optimize for speed, cost, or capability.",
    },
    {
        question: "How do I get started with Elyt?",
        answer: "Contact our sales team and we'll walk you through a demo tailored to your use case. We work with each customer to build a custom plan that fits their automation needs.",
    },
    {
        question: "Can I run Elyt locally or is it cloud-only?",
        answer: "Both. Elyt is available as a cloud-based web platform for convenience, and as a downloadable local executable for users who prefer to run automations from their own machines. Your data stays where you want it.",
    },
];
---

<div id="faq" class="py-16">
    <Container>
        <div class="lg:flex lg:gap-20">
            <!-- Left: sticky heading -->
            <div class="lg:w-1/3 mb-12 lg:mb-0">
                <div class="lg:sticky lg:top-32">
                    <span class="text-sm font-medium uppercase tracking-widest text-primary">FAQ</span>
                    <h2 class="mt-4 text-3xl font-bold text-gray-900 dark:text-white md:text-4xl">
                        Frequently asked questions
                    </h2>
                    <p class="mt-4 text-gray-600 dark:text-gray-400">
                        Can't find what you're looking for? Book a demo and we'll walk you through everything.
                    </p>
                </div>
            </div>

            <!-- Right: accordion -->
            <div class="lg:w-2/3">
                <div class="divide-y divide-gray-100 dark:divide-gray-800">
                    {faqs.map((faq, i) => (
                        <details class="group py-6" open={i === 0}>
                            <summary class="flex cursor-pointer items-center justify-between text-left">
                                <h3 class="text-lg font-semibold text-gray-900 dark:text-white pr-8 group-open:text-primary transition-colors">
                                    {faq.question}
                                </h3>
                                <span class="shrink-0 ml-4">
                                    <svg class="w-5 h-5 text-gray-400 transition-transform duration-300 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                    </svg>
                                </span>
                            </summary>
                            <p class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed pr-12">
                                {faq.answer}
                            </p>
                        </details>
                    ))}
                </div>
            </div>
        </div>
    </Container>
</div>
