---
import Container from "./Container.astro"

const features = [
    {
        title: "Mass Profile Orchestration",
        description: "Run your AI automation across hundreds of browser profiles simultaneously. Each profile has its own fingerprint, proxy, cookies, and identity — completely isolated. Scale from 1 to 1,000 profiles without changing a single workflow.",
        image: "/Elyt/images/browserprofiles.png",
        badge: "Scale",
    },
    {
        title: "AI Humanizer",
        description: "Elyt's AI humanizer generates realistic mouse movements, natural typing rhythms, random scroll patterns, and human-like pauses. Your automated sessions behave like real users — so they last longer and work more reliably.",
        image: "/Elyt/images/actions.png",
        badge: "Reliability",
    },
    {
        title: "Visual Workflow System",
        description: "Build complex multi-step automations with a visual node editor. Chain AI actions, add conditional logic, pass data between steps, and schedule everything to run on autopilot. No coding required — describe each step in plain English.",
        image: "/Elyt/images/workflows.png",
        badge: "Power",
    },
];
---

<div id="features" class="relative py-16">
    <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-[0.14] dark:opacity-[0.07]">
        <div class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"></div>
        <div class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"></div>
    </div>
    <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="text-sm font-medium uppercase tracking-widest text-secondary">Features</span>
            <h2 class="mt-4 text-3xl font-bold text-gray-900 dark:text-white md:text-5xl">
                What makes Elyt different
            </h2>
            <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
                The only platform that combines mass automation, AI humanization, and visual workflows in one tool.
            </p>
        </div>

        <div class="space-y-20">
            {features.map((feature, i) => (
                <div data-feature-card class:list={[
                    "lg:flex lg:items-center lg:gap-16",
                    i % 2 === 1 ? "lg:flex-row-reverse" : ""
                ]}>
                    <!-- Image -->
                    <div class="lg:w-1/2 mb-8 lg:mb-0">
                        <div class="relative overflow-hidden rounded-3xl">
                            <img
                                src={feature.image}
                                alt={feature.title}
                                class="w-full h-auto rounded-3xl"
                                loading="lazy"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
                            <span class="absolute bottom-4 left-4 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/90 text-gray-900">
                                {feature.badge}
                            </span>
                        </div>
                    </div>
                    <!-- Content -->
                    <div class="lg:w-1/2">
                        <h3 class="text-2xl font-bold text-gray-900 dark:text-white md:text-3xl">
                            {feature.title}
                        </h3>
                        <p class="mt-6 text-gray-600 dark:text-gray-400 leading-relaxed text-lg">
                            {feature.description}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </Container>
</div>
