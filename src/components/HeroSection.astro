---
import Container from "./Container.astro"
import LaptopVideo from "./LaptopVideo.astro"
import { CONTACT } from "../consts"
---

<div class="relative" id="home">
    <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-20">
        <div class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"></div>
        <div class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"></div>
    </div>
    <Container>
        <div class="relative pt-36 ml-auto">
            <div class="lg:w-4/5 text-center mx-auto">
                <h1 class="text-gray-900 text-balance dark:text-white font-extrabold text-4xl md:text-6xl xl:text-7xl leading-tight">
                    Automate Any Website.<br/>
                    <span class="text-primary">Across Hundreds of Profiles.</span><br/>
                    Without Getting Detected.
                </h1>
                <p class="mt-8 text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
                    Elyt pairs AI browser automation with anti-detect browsers so you can run tasks across unlimited profiles — with human-like behavior that bypasses every bot check.
                </p>
                <div class="mt-10 flex flex-wrap justify-center gap-y-4 gap-x-4">
                    <button
                      data-contact-modal
                      class="relative flex h-12 w-full items-center justify-center px-8 before:absolute before:inset-0 before:rounded-full before:bg-primary before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 sm:w-max"
                    >
                      <span class="relative text-base font-semibold text-white">Request Access</span>
                    </button>
                    <button
                      data-cal-link={CONTACT.CAL_LINK}
                      data-cal-config='{"theme":"light"}'
                      class="relative flex h-12 w-full items-center justify-center px-8 before:absolute before:inset-0 before:rounded-full before:border before:border-transparent before:bg-primary/10 before:bg-gradient-to-b before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 dark:before:border-gray-700 dark:before:bg-gray-800 sm:w-max"
                    >
                      <span class="relative text-base font-semibold text-primary dark:text-white">Book a Demo</span>
                    </button>
                </div>
            </div>

            <!-- Video Demo -->
            <div class="mt-16">
                <LaptopVideo
                    videoSrc="/Elyt/videos/video.mp4"
                    webmSrc="/Elyt/videos/video.webm"
                    posterSrc="/Elyt/images/poster.webp"
                />
            </div>

            <!-- Proof Points -->
            <div class="hidden py-8 mt-12 border-y border-gray-100 dark:border-gray-800 sm:flex justify-between max-w-3xl mx-auto">
                <div class="text-center px-4">
                    <h6 class="text-2xl font-bold text-gray-900 dark:text-white">Infinite</h6>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Browser Profiles</p>
                </div>
                <div class="text-center px-4">
                    <h6 class="text-2xl font-bold text-gray-900 dark:text-white">3+</h6>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Anti-Detect Providers</p>
                </div>
                <div class="text-center px-4">
                    <h6 class="text-2xl font-bold text-gray-900 dark:text-white">10+</h6>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">AI Model Providers</p>
                </div>
            </div>
        </div>
    </Container>
</div>
