---
import Container from "./Container.astro"
import LaptopVideo from "./LaptopVideo.astro"
import { CONTACT } from "../consts"
---

<div class="relative" id="home">
    <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-20">
        <div class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"></div>
        <div class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"></div>
    </div>
    <Container>
        <div class="relative pt-32 pb-16 ml-auto">
            <div class="lg:w-4/5 text-center mx-auto">
                <h1 class="text-gray-900 text-balance dark:text-white font-extrabold text-4xl md:text-6xl xl:text-7xl leading-tight">
                    Automate Any Website.<br/>
                    <span class="text-gradient">At Any Scale.</span>
                </h1>
                <p class="mt-8 text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
                    Build AI-powered workflows that run across unlimited browser profiles — describe tasks in plain English, schedule them, and let Elyt handle the rest.
                </p>
                <div class="mt-10 flex flex-wrap justify-center gap-y-4 gap-x-4">
                    <button
                      data-contact-modal
                      class="btn-gradient flex h-12 w-full items-center justify-center px-8 rounded-full text-base font-semibold text-white active:scale-[0.98] sm:w-max"
                    >
                      Contact Sales
                    </button>
                    <button
                      data-cal-link={CONTACT.CAL_LINK}
                      data-cal-config='{"theme":"light"}'
                      class="flex h-12 w-full items-center justify-center px-8 rounded-full border border-purple-200 bg-white text-base font-semibold text-primary hover:bg-purple-50 transition-all duration-200 active:scale-[0.98] dark:border-gray-700 dark:bg-gray-800 dark:text-white sm:w-max"
                    >
                      Book a Demo
                    </button>
                </div>
            </div>

            <!-- Video Demo -->
            <div class="mt-16">
                <LaptopVideo
                    videoSrc="/Elyt/videos/video.mp4"
                    webmSrc="/Elyt/videos/video.webm"
                    posterSrc="/Elyt/images/poster.webp"
                />
            </div>

            <!-- Proof Points (commented out)
            <div class="hidden mt-16 sm:flex justify-center gap-12 md:gap-20 max-w-3xl mx-auto">
                <div class="flex flex-col items-center gap-2">
                    <span class="infinity-flow text-5xl font-extrabold">∞</span>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Browser Profiles</p>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <span class="infinity-flow text-5xl font-extrabold">∞</span>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Anti-Detect Providers</p>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <span class="infinity-flow text-5xl font-extrabold">∞</span>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">AI Model Providers</p>
                </div>
            </div>
            -->
        </div>
    </Container>
</div>
