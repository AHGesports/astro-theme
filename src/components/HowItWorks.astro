---
import Container from "./Container.astro"
import HowConnectProfiles from "./illustrations/HowConnectProfiles.astro"
import HowBuildWorkflows from "./illustrations/HowBuildWorkflows.astro"
import HowRunProfiles from "./illustrations/HowRunProfiles.astro"

const steps = [
    {
        step: "01",
        title: "Connect & Create Profiles",
        description: "Link your browser provider — AdsPower, MoreLogin, GoLogin, and many more — or connect a custom solution via CDP. Create as many profiles as you need, each with its own fingerprint, proxy, and identity.",
    },
    {
        step: "02",
        title: "Build Workflows in Plain English",
        description: "Describe what you want to automate in natural language. Chain multiple AI nodes together into complex workflows with conditional logic, loops, and data passing between steps.",
    },
    {
        step: "03",
        title: "Run Across All Profiles on Schedule",
        description: "Launch your workflow across every profile simultaneously or staggered. Set recurring schedules. Elyt's AI humanizer makes each execution look like a real person browsing.",
    },
];
---

<div class="relative py-16 md:py-24" id="how-it-works">
    <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-[0.14] dark:opacity-[0.07]">
        <div class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"></div>
        <div class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"></div>
    </div>
    <Container>
        <div class="text-center max-w-3xl mx-auto mb-14 md:mb-20">
            <span class="text-sm font-medium uppercase tracking-widest text-primary">How It Works</span>
            <h2 class="mt-4 text-3xl font-bold text-gray-900 dark:text-white md:text-5xl">
                Three steps to mass automation
            </h2>
        </div>

        <!-- Mobile: simple stack -->
        <div class="md:hidden space-y-10">
            {steps.map((item, i) => (
                <div>
                    <!-- Step number -->
                    <div class="flex items-center gap-3 mb-3">
                        <span class="flex items-center justify-center w-12 h-12 aspect-square rounded-full bg-gradient-to-br from-[#667eea] to-[#764ba2] text-white font-bold text-base shadow-xl shadow-indigo-500/30 flex-shrink-0">
                            {item.step}
                        </span>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">{item.title}</h3>
                    </div>
                    <div class="overflow-hidden rounded-2xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-lg shadow-gray-200/50 dark:shadow-none">
                        <div class="aspect-square">
                            {i === 0 && <HowConnectProfiles class="w-full h-full" />}
                            {i === 1 && <HowBuildWorkflows class="w-full h-full" />}
                            {i === 2 && <HowRunProfiles class="w-full h-full" />}
                        </div>
                        <div class="px-5 py-4">
                            <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm">{item.description}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <!-- Desktop: left-right-left layout with big step circles -->
        <div class="hidden md:block space-y-20 lg:space-y-24">

            <!-- Step 1: card left, circle right -->
            <div class="flex items-center gap-6 lg:gap-10">
                <div class="w-[78%] rotate-[-2.5deg]">
                    <div class="group overflow-hidden rounded-2xl lg:rounded-3xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-lg shadow-gray-200/50 dark:shadow-none transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
                        <div class="aspect-video">
                            <HowConnectProfiles class="w-full h-full" />
                        </div>
                        <div class="px-6 lg:px-8 py-5 lg:py-6">
                            <h3 class="text-lg lg:text-xl font-bold text-gray-900 dark:text-white">{steps[0].title}</h3>
                            <p class="mt-1.5 text-gray-600 dark:text-gray-400 leading-relaxed text-sm lg:text-base">{steps[0].description}</p>
                        </div>
                    </div>
                </div>
                <div class="flex-1 flex justify-center">
                    <span class="flex items-center justify-center w-18 h-18 lg:w-22 lg:h-22 rounded-full bg-gradient-to-br from-[#667eea] to-[#764ba2] text-white font-bold text-3xl lg:text-4xl shadow-xl shadow-indigo-500/30 rotate-[6deg]">01</span>
                </div>
            </div>

            <!-- Step 2: circle left, card right -->
            <div class="flex items-center gap-6 lg:gap-10">
                <div class="flex-1 flex justify-center">
                    <span class="flex items-center justify-center w-18 h-18 lg:w-22 lg:h-22 rounded-full bg-gradient-to-br from-[#667eea] to-[#764ba2] text-white font-bold text-3xl lg:text-4xl shadow-xl shadow-indigo-500/30 rotate-[-5deg]">02</span>
                </div>
                <div class="w-[78%] rotate-[2.5deg]">
                    <div class="group overflow-hidden rounded-2xl lg:rounded-3xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-lg shadow-gray-200/50 dark:shadow-none transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
                        <div class="aspect-video">
                            <HowBuildWorkflows class="w-full h-full" />
                        </div>
                        <div class="px-6 lg:px-8 py-5 lg:py-6">
                            <h3 class="text-lg lg:text-xl font-bold text-gray-900 dark:text-white">{steps[1].title}</h3>
                            <p class="mt-1.5 text-gray-600 dark:text-gray-400 leading-relaxed text-sm lg:text-base">{steps[1].description}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: card left, circle right -->
            <div class="flex items-center gap-6 lg:gap-10">
                <div class="w-[78%] rotate-[-1.8deg]">
                    <div class="group overflow-hidden rounded-2xl lg:rounded-3xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-lg shadow-gray-200/50 dark:shadow-none transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
                        <div class="aspect-video">
                            <HowRunProfiles class="w-full h-full" />
                        </div>
                        <div class="px-6 lg:px-8 py-5 lg:py-6">
                            <h3 class="text-lg lg:text-xl font-bold text-gray-900 dark:text-white">{steps[2].title}</h3>
                            <p class="mt-1.5 text-gray-600 dark:text-gray-400 leading-relaxed text-sm lg:text-base">{steps[2].description}</p>
                        </div>
                    </div>
                </div>
                <div class="flex-1 flex justify-center">
                    <span class="flex items-center justify-center w-18 h-18 lg:w-22 lg:h-22 rounded-full bg-gradient-to-br from-[#667eea] to-[#764ba2] text-white font-bold text-3xl lg:text-4xl shadow-xl shadow-indigo-500/30 rotate-[4deg]">03</span>
                </div>
            </div>

        </div>
    </Container>
</div>

