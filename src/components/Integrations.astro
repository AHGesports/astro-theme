---
import Container from "./Container.astro"

const providers = [
    { name: "AdsPower", logo: "/images/clients/adspower.png", width: "130px" },
    { name: "MoreLogin", logo: "/images/clients/morelogin.png", width: "140px" },
    { name: "GoLogin", logo: "/images/clients/gologin.svg", width: "130px" },
    { name: "MultiLogin", logo: "/images/clients/multilogin.svg", width: "130px" },
    { name: "Kameleo", logo: "/images/clients/kameleo.svg", width: "118px" },
    { name: "Dolphin Anty", logo: "/images/clients/dolphin-anty.png", width: "130px" },
    { name: "Incogniton", logo: "/images/clients/incogniton.svg", width: "118px" },
    // { name: "Undetectable", logo: "/images/clients/undetectable.svg", width: "130px" },
];
---

<div class="py-8">
    <Container>
        <p class="text-center text-sm font-medium uppercase tracking-widest text-gray-500 dark:text-gray-400">
            Works with your favorite browser providers
        </p>
    </Container>

    <div class="marquee-wrap mt-8" aria-label="Anti-detect browser partners">
        <div class="marquee-track">
            {[...providers, ...providers, ...providers].map((p, i) => (
                <div class="marquee-item" aria-hidden={i >= providers.length ? "true" : undefined}>
                    <img src={p.logo} alt={i < providers.length ? p.name : ""} class="h-auto object-contain" style={`width: ${p.width};`} loading="lazy" draggable="false" />
                </div>
            ))}
        </div>
    </div>
</div>

<style>
    .marquee-wrap {
        position: relative;
        overflow: hidden;
        /* Fade masks on left/right edges */
        mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }

    .marquee-track {
        display: flex;
        align-items: center;
        gap: 0;
        width: max-content;
        animation: marquee 25s linear infinite;
    }

    .marquee-wrap:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-item {
        flex-shrink: 0;
        padding: 0 2.5rem;
        height: 2rem;
        display: flex;
        align-items: center;
        /* Normalize all logos to monochrome — handles white/dark/colored SVGs uniformly */
        filter: brightness(0) opacity(0.4);
        transition: filter 0.3s ease, opacity 0.3s ease;
    }

    .marquee-item:hover {
        filter: brightness(0) opacity(0.7);
    }

    @media (prefers-color-scheme: dark) {
        .marquee-item {
            filter: brightness(0) invert(1) opacity(0.4);
        }
        .marquee-item:hover {
            filter: brightness(0) invert(1) opacity(0.7);
        }
    }

    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(calc(-100% / 3)); }
    }

    /* Accessibility: respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .marquee-track {
            animation: none;
            justify-content: center;
            flex-wrap: wrap;
            width: auto;
        }
        .marquee-item[aria-hidden="true"] {
            display: none;
        }
        .marquee-wrap {
            mask-image: none;
            -webkit-mask-image: none;
        }
    }
</style>
