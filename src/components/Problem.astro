---
import Container from "./Container.astro"
import ProblemSingleBrowser from "./illustrations/ProblemSingleBrowser.astro"
import ProblemDetected from "./illustrations/ProblemDetected.astro"
import ProblemSimplePrompts from "./illustrations/ProblemSimplePrompts.astro"

const problems = [
    {
        number: "01",
        title: "One Browser. One Account. That's It.",
        description: "Every AI automation tool on the market controls a single browser. Need to run tasks across dozens or hundreds of accounts? You're on your own.",
    },
    {
        number: "02",
        title: "Automation That Looks Like Automation.",
        description: "Most AI tools click with robotic precision — identical timing, zero variation, no human nuance. Websites can tell it's not a real person, and your sessions don't last.",
    },
    {
        number: "03",
        title: "One Task at a Time. No Orchestration.",
        description: "Other tools run a single action in a single browser and call it done. No multi-step workflows, no scheduling, no way to coordinate tasks across accounts. You're stuck babysitting every session yourself.",
    },
];
---

<div class="relative py-16 bg-violet-50/40 dark:bg-gray-900/50">
    <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-[0.14] dark:opacity-[0.07]">
        <div class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"></div>
        <div class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"></div>
    </div>
    <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="text-sm font-medium uppercase tracking-widest text-amber-600">The Problem</span>
            <h2 class="mt-4 text-3xl font-bold text-gray-900 dark:text-white md:text-5xl">
                Why current AI automation tools fail
            </h2>
        </div>

        <div class="space-y-8 lg:space-y-6">
            {problems.map((problem, i) => (
                <div class:list={[
                    "group relative overflow-hidden rounded-3xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 transition hover:shadow-2xl hover:shadow-gray-600/10",
                    "lg:flex lg:items-center",
                    i % 2 === 1 ? "lg:flex-row-reverse" : ""
                ]}>
                    <!-- Illustration side -->
                    <div class="lg:w-1/2 overflow-hidden transition duration-500 group-hover:scale-105">
                        {i === 0 && <ProblemSingleBrowser class="w-full h-72 sm:h-80 lg:h-80" />}
                        {i === 1 && <ProblemDetected class="w-full h-72 sm:h-80 lg:h-80" />}
                        {i === 2 && <ProblemSimplePrompts class="w-full h-72 sm:h-80 lg:h-80" />}
                    </div>
                    <!-- Content side -->
                    <div class="lg:w-1/2 p-6 lg:p-12">
                        <span class="text-6xl font-extrabold text-gray-100 dark:text-gray-800">{problem.number}</span>
                        <h3 class="mt-4 text-xl font-bold text-gray-900 dark:text-white md:text-2xl">
                            {problem.title}
                        </h3>
                        <p class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed">
                            {problem.description}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </Container>
</div>
