---
import Container from "./Container.astro"

const useCases = [
    {
        platform: "Data Collection",
        description: "Extract structured data from any website with AI — no selectors needed. Run across thousands of pages in parallel.",
        gradient: "from-indigo-500 to-violet-500",
        bgGradient: "from-indigo-50 to-violet-50 dark:from-indigo-950/20 dark:to-violet-950/20",
        icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/></svg>`,
    },
    {
        platform: "E-commerce",
        description: "Monitor prices across 1,000 products and get instant alerts when they drop.",
        gradient: "from-emerald-500 to-teal-500",
        bgGradient: "from-emerald-50 to-teal-50 dark:from-emerald-950/20 dark:to-teal-950/20",
        icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
    },
    {
        platform: "Lead Generation",
        description: "Collect prospect data from directories, enrich profiles, and export to your CRM — across hundreds of sessions.",
        gradient: "from-amber-500 to-orange-500",
        bgGradient: "from-amber-50 to-orange-50 dark:from-amber-950/20 dark:to-orange-950/20",
        icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    },
    {
        platform: "Instagram",
        description: "Auto-follow, DM, and engage across 50 accounts simultaneously.",
        gradient: "from-pink-500 to-rose-500",
        bgGradient: "from-pink-50 to-rose-50 dark:from-pink-950/20 dark:to-rose-950/20",
        icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
    },
    {
        platform: "LinkedIn",
        description: "Send personalized connection requests and messages to 200 prospects a day.",
        gradient: "from-blue-600 to-blue-700",
        bgGradient: "from-blue-50 to-indigo-50 dark:from-blue-950/20 dark:to-indigo-950/20",
        icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    },
    {
        platform: "Any Website",
        description: "If it runs in a browser, Elyt can automate it — just describe the task in plain English.",
        gradient: "from-primary to-indigo-700",
        bgGradient: "from-indigo-50 to-purple-50 dark:from-indigo-950/20 dark:to-purple-950/20",
        icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
        highlight: true,
    },
];
---

<div class="relative py-16 bg-violet-50/40 dark:bg-gray-900/50" id="use-cases">
    <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-[0.14] dark:opacity-[0.07]">
        <div class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"></div>
        <div class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"></div>
    </div>
    <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="text-sm font-medium uppercase tracking-widest text-primary">Use Cases</span>
            <h2 class="mt-4 text-3xl font-bold text-gray-900 dark:text-white md:text-5xl">
                What can you automate?
            </h2>
            <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
                Real scenarios. Real platforms. Running across hundreds of profiles at once.
            </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {useCases.map((useCase) => (
                <div class:list={[
                    "relative overflow-hidden rounded-3xl p-8 transition-all duration-300",
                    useCase.highlight
                        ? "bg-gradient-to-br from-primary to-indigo-700 text-white ring-2 ring-primary/50 ring-offset-2 ring-offset-white dark:ring-offset-gray-950"
                        : `bg-gradient-to-br ${useCase.bgGradient} border border-gray-100 dark:border-gray-800`,
                ]}>
                    <!-- Platform icon -->
                    <div class:list={[
                        "inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-6",
                        useCase.highlight
                            ? "bg-white/20 text-white"
                            : `bg-gradient-to-br ${useCase.gradient} text-white`,
                    ]}>
                        <Fragment set:html={useCase.icon} />
                    </div>

                    <h3 class:list={[
                        "text-xl font-bold mb-3",
                        useCase.highlight ? "text-white" : "text-gray-900 dark:text-white",
                    ]}>
                        {useCase.platform}
                    </h3>
                    <p class:list={[
                        "leading-relaxed",
                        useCase.highlight ? "text-indigo-100" : "text-gray-600 dark:text-gray-400",
                    ]}>
                        {useCase.description}
                    </p>

                </div>
            ))}
        </div>
    </Container>
</div>
