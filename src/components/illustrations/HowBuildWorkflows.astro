---
const { class: className, ...rest } = Astro.props;
---

<div class:list={["relative overflow-hidden bg-gradient-to-br from-indigo-50 to-purple-50/60 dark:from-[#1e1b4b] dark:to-[#1a0a2e]", className]} {...rest}>
    <div class="absolute inset-0 flex items-center justify-center p-5 sm:p-7 md:p-8">

        <div class="w-full max-w-2xl rounded-2xl overflow-hidden border border-indigo-200/60 dark:border-indigo-500/20 shadow-lg shadow-indigo-500/5 dark:shadow-indigo-500/10 bg-white dark:bg-gray-900">
            <!-- Header -->
            <div class="h-9 sm:h-10 bg-gradient-to-r from-[#667eea] to-[#764ba2] flex items-center px-3 sm:px-4 gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-white/40"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-white/25"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-white/15"></div>
                <span class="text-[9px] sm:text-xs text-white/60 font-medium ml-2">Workflow Builder</span>
                <div class="ml-auto flex items-center gap-1">
                    <div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div>
                    <span class="text-[8px] sm:text-[10px] text-white/50">5 nodes</span>
                </div>
            </div>

            <div class="flex divide-x divide-indigo-100 dark:divide-indigo-800/30">

                <!-- Left: prompt input (already sent) -->
                <div class="w-[42%] p-3 sm:p-4 space-y-2.5">
                    <div class="flex items-center gap-1.5">
                        <img src="/Elyt/images/chat-bubble-left.svg" alt="" class="w-3 h-3 opacity-40 dark:invert dark:opacity-30" />
                        <span class="text-[8px] sm:text-[10px] text-indigo-400/60 dark:text-indigo-500/40 font-medium">Your prompt</span>
                    </div>
                    <div class="rounded-lg border border-indigo-100 dark:border-indigo-800/30 bg-indigo-50/40 dark:bg-indigo-950/20 p-2.5">
                        <p class="text-[8px] sm:text-[10px] text-indigo-900/50 dark:text-indigo-300/40 leading-relaxed">"Go to LinkedIn, search for marketing managers, send a connection request with a personalized message, then wait for acceptance and send a follow-up DM"</p>
                    </div>
                    <!-- Sent indicator -->
                    <div class="flex items-center gap-1.5">
                        <div class="h-5 sm:h-6 px-2.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center gap-1">
                            <img src="/Elyt/images/check-circle.svg" alt="" class="w-3 h-3 opacity-50 dark:invert dark:opacity-40" />
                            <span class="text-[8px] sm:text-[10px] text-emerald-600/60 dark:text-emerald-400/50 font-medium">Generated</span>
                        </div>
                    </div>
                </div>

                <!-- Right: generated workflow -->
                <div class="flex-1 p-3 sm:p-4 space-y-1.5 sm:space-y-2">

                    <!-- Node 1 -->
                    <div class="flex items-center gap-2 sm:gap-3">
                        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#667eea]/15 dark:bg-[#667eea]/25 flex items-center justify-center flex-shrink-0">
                            <img src="/Elyt/images/sparkles.svg" alt="" class="w-3.5 h-3.5 opacity-50 dark:invert dark:opacity-40" />
                        </div>
                        <div class="flex-1 h-6 sm:h-7 rounded-lg bg-indigo-50/80 dark:bg-indigo-950/30 flex items-center px-2.5">
                            <span class="text-[8px] sm:text-[10px] text-indigo-400/70 dark:text-indigo-400/50">Open LinkedIn & search</span>
                        </div>
                        <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </div>
                    </div>

                    <div class="flex justify-center"><div class="w-px h-2 bg-[#667eea]/20"></div></div>

                    <!-- Node 2 -->
                    <div class="flex items-center gap-2 sm:gap-3">
                        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#764ba2]/15 dark:bg-[#764ba2]/25 flex items-center justify-center flex-shrink-0">
                            <img src="/Elyt/images/cpu-chip.svg" alt="" class="w-3.5 h-3.5 opacity-50 dark:invert dark:opacity-40" />
                        </div>
                        <div class="flex-1 h-6 sm:h-7 rounded-lg bg-purple-50/80 dark:bg-purple-950/30 flex items-center px-2.5">
                            <span class="text-[8px] sm:text-[10px] text-purple-400/70 dark:text-purple-400/50">Send connection request</span>
                        </div>
                        <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </div>
                    </div>

                    <div class="flex justify-center"><div class="w-px h-2 bg-[#667eea]/20"></div></div>

                    <!-- Node 3: Condition -->
                    <div class="flex items-center gap-2 sm:gap-3">
                        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-amber-500/15 dark:bg-amber-500/25 flex items-center justify-center flex-shrink-0 rotate-45">
                            <img src="/Elyt/images/arrows-right-left.svg" alt="" class="w-3.5 h-3.5 -rotate-45 opacity-50 dark:invert dark:opacity-40" />
                        </div>
                        <div class="flex-1 h-6 sm:h-7 rounded-lg bg-amber-50/80 dark:bg-amber-950/30 flex items-center px-2.5">
                            <span class="text-[8px] sm:text-[10px] text-amber-500/70 dark:text-amber-400/50">If accepted →</span>
                        </div>
                        <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </div>
                    </div>

                    <div class="flex justify-center"><div class="w-px h-2 bg-[#667eea]/20"></div></div>

                    <!-- Node 4: Loop -->
                    <div class="flex items-center gap-2 sm:gap-3">
                        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#667eea]/15 dark:bg-[#667eea]/25 flex items-center justify-center flex-shrink-0">
                            <img src="/Elyt/images/arrow-path.svg" alt="" class="w-3.5 h-3.5 opacity-50 dark:invert dark:opacity-40" />
                        </div>
                        <div class="flex-1 h-6 sm:h-7 rounded-lg bg-indigo-50/80 dark:bg-indigo-950/30 flex items-center px-2.5">
                            <span class="text-[8px] sm:text-[10px] text-indigo-400/70 dark:text-indigo-400/50">Wait & retry loop</span>
                        </div>
                        <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </div>
                    </div>

                    <div class="flex justify-center"><div class="w-px h-2 bg-[#667eea]/20"></div></div>

                    <!-- Node 5 -->
                    <div class="flex items-center gap-2 sm:gap-3">
                        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#764ba2]/15 dark:bg-[#764ba2]/25 flex items-center justify-center flex-shrink-0">
                            <img src="/Elyt/images/sparkles.svg" alt="" class="w-3.5 h-3.5 opacity-50 dark:invert dark:opacity-40" />
                        </div>
                        <div class="flex-1 h-6 sm:h-7 rounded-lg bg-purple-50/80 dark:bg-purple-950/30 flex items-center px-2.5">
                            <span class="text-[8px] sm:text-[10px] text-purple-400/70 dark:text-purple-400/50">Send follow-up DM</span>
                        </div>
                        <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>
