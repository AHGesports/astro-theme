---
const { class: className, ...rest } = Astro.props;
---

<div class:list={["relative overflow-hidden bg-gradient-to-br from-indigo-50 to-purple-50/60 dark:from-[#1e1b4b] dark:to-[#1a0a2e]", className]} {...rest}>
    <div class="absolute inset-0 flex items-center justify-center p-5 sm:p-7 md:p-8">

        <!-- Main profile card -->
        <div class="relative z-10 w-full max-w-2xl rounded-2xl overflow-hidden border border-indigo-200/60 dark:border-indigo-500/20 shadow-lg shadow-indigo-500/5 dark:shadow-indigo-500/10 bg-white dark:bg-gray-900">
            <!-- Header bar -->
            <div class="h-9 sm:h-10 bg-gradient-to-r from-[#667eea] to-[#764ba2] flex items-center px-4 gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-white/40"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-white/25"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-white/15"></div>
                <span class="text-xs text-white/60 font-medium ml-2">New Profile</span>
                <div class="ml-auto text-[10px] text-white/40 font-medium">#47 of 200</div>
            </div>

            <!-- Profile form body -->
            <div class="px-4 sm:px-5 py-4 space-y-3">
                <!-- Profile name field -->
                <div class="h-8 rounded-lg border border-indigo-100 dark:border-indigo-800/30 bg-indigo-50/50 dark:bg-indigo-950/20 flex items-center px-3">
                    <span class="text-xs text-indigo-400/70 dark:text-indigo-400/50 font-medium">Profile-047</span>
                </div>

                <!-- Three feature rows -->
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#667eea]/10 dark:bg-[#667eea]/20 flex items-center justify-center flex-shrink-0">
                        <img src="/Elyt/images/finger-print.svg" alt="" class="w-4.5 h-4.5 opacity-60 dark:invert dark:opacity-40" />
                    </div>
                    <div class="flex-1 h-7 rounded-lg bg-indigo-50/80 dark:bg-indigo-950/30 flex items-center px-3">
                        <span class="text-[10px] text-indigo-300 dark:text-indigo-500/60">Unique fingerprint assigned</span>
                    </div>
                    <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#764ba2]/10 dark:bg-[#764ba2]/20 flex items-center justify-center flex-shrink-0">
                        <img src="/Elyt/images/globe-alt.svg" alt="" class="w-4.5 h-4.5 opacity-60 dark:invert dark:opacity-40" />
                    </div>
                    <div class="flex-1 h-7 rounded-lg bg-purple-50/80 dark:bg-purple-950/30 flex items-center px-3">
                        <span class="text-[10px] text-purple-300 dark:text-purple-500/60">Dedicated proxy connected</span>
                    </div>
                    <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#667eea]/10 dark:bg-[#667eea]/20 flex items-center justify-center flex-shrink-0">
                        <img src="/Elyt/images/shield-check.svg" alt="" class="w-4.5 h-4.5 opacity-60 dark:invert dark:opacity-40" />
                    </div>
                    <div class="flex-1 h-7 rounded-lg bg-indigo-50/80 dark:bg-indigo-950/30 flex items-center px-3">
                        <span class="text-[10px] text-indigo-300 dark:text-indigo-500/60">Identity isolated</span>
                    </div>
                    <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#764ba2]/10 dark:bg-[#764ba2]/20 flex items-center justify-center flex-shrink-0">
                        <img src="/Elyt/images/clock.svg" alt="" class="w-4.5 h-4.5 opacity-60 dark:invert dark:opacity-40" />
                    </div>
                    <div class="flex-1 h-7 rounded-lg bg-purple-50/80 dark:bg-purple-950/30 flex items-center px-3">
                        <span class="text-[10px] text-purple-300 dark:text-purple-500/60">Timezone: UTC+2 (auto)</span>
                    </div>
                    <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#667eea]/10 dark:bg-[#667eea]/20 flex items-center justify-center flex-shrink-0">
                        <img src="/Elyt/images/user-circle.svg" alt="" class="w-4.5 h-4.5 opacity-60 dark:invert dark:opacity-40" />
                    </div>
                    <div class="flex-1 h-7 rounded-lg bg-indigo-50/80 dark:bg-indigo-950/30 flex items-center px-3">
                        <span class="text-[10px] text-indigo-300 dark:text-indigo-500/60">Anti-detect browser connected</span>
                    </div>
                    <div class="w-6 h-6 rounded-full bg-emerald-500/15 flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
