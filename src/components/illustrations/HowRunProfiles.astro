---
const { class: className, ...rest } = Astro.props;

const profiles = [
    { name: "Profile-001", status: "Running", color: "emerald" },
    { name: "Profile-002", status: "Running", color: "emerald" },
    { name: "Profile-003", status: "Running", color: "emerald" },
    { name: "Profile-004", status: "Running", color: "emerald" },
    { name: "Profile-005", status: "Queued", color: "amber" },
];
---

<div class:list={["relative overflow-hidden bg-gradient-to-br from-indigo-50 to-purple-50/60 dark:from-[#1e1b4b] dark:to-[#1a0a2e]", className]} {...rest}>
    <div class="absolute inset-0 flex items-center justify-center p-5 sm:p-7 md:p-8">

        <div class="w-full max-w-2xl rounded-2xl overflow-hidden border border-indigo-200/60 dark:border-indigo-500/20 shadow-lg shadow-indigo-500/5 dark:shadow-indigo-500/10 bg-white dark:bg-gray-900">
            <!-- Header -->
            <div class="h-9 sm:h-10 bg-gradient-to-r from-[#667eea] to-[#764ba2] flex items-center px-4 gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-white/40"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-white/25"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-white/15"></div>
                <span class="text-xs text-white/60 font-medium ml-2">Run Workflow</span>
                <div class="ml-auto flex items-center gap-1.5">
                    <img src="/Elyt/images/clock.svg" alt="" class="w-3.5 h-3.5 brightness-0 invert opacity-40" />
                    <span class="text-[10px] text-white/50">Daily 9:00 AM</span>
                </div>
            </div>

            <!-- Profile run list -->
            <div class="px-3 sm:px-4 py-2.5 sm:py-3 space-y-1.5 sm:space-y-2">
                {profiles.map((p) => (
                    <div class="flex items-center gap-2 sm:gap-3 px-2.5 sm:px-3 py-1.5 sm:py-2 rounded-xl bg-indigo-50/50 dark:bg-indigo-950/20 border border-indigo-100/50 dark:border-indigo-800/20">
                        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-[#667eea]/15 dark:bg-[#667eea]/25 flex items-center justify-center flex-shrink-0">
                            <img src="/Elyt/images/user.svg" alt="" class="w-3.5 h-3.5 opacity-40 dark:invert dark:opacity-30" />
                        </div>
                        <span class="text-[9px] sm:text-xs text-indigo-900/50 dark:text-indigo-300/40 font-medium flex-1">{p.name}</span>
                        <img src="/Elyt/images/finger-print.svg" alt="" class="w-3.5 h-3.5 opacity-20 dark:invert dark:opacity-15 flex-shrink-0 hidden sm:block" />
                        <img src="/Elyt/images/shield-check.svg" alt="" class="w-3.5 h-3.5 opacity-20 dark:invert dark:opacity-15 flex-shrink-0 hidden sm:block" />
                        <div class="flex items-center gap-1 flex-shrink-0">
                            <div class:list={["w-2 h-2 rounded-full",
                                p.color === "emerald" ? "bg-emerald-500" : "bg-amber-500"
                            ]}></div>
                            <span class:list={["text-[8px] sm:text-[10px] font-medium",
                                p.color === "emerald" ? "text-emerald-600 dark:text-emerald-400" : "text-amber-600 dark:text-amber-400"
                            ]}>{p.status}</span>
                        </div>
                    </div>
                ))}
            </div>

            <!-- Footer: progress bar -->
            <div class="px-4 py-2.5 border-t border-indigo-100/40 dark:border-indigo-800/20 flex items-center gap-3">
                <div class="flex-1 h-2 rounded-full bg-indigo-100/60 dark:bg-indigo-900/30 overflow-hidden">
                    <div class="h-full w-[43%] rounded-full bg-gradient-to-r from-[#667eea] to-[#764ba2]"></div>
                </div>
                <span class="text-[9px] sm:text-xs text-indigo-400/60 dark:text-indigo-500/40 font-medium flex-shrink-0">4 / 5</span>
            </div>
        </div>

    </div>
</div>
