---
const { class: className, ...rest } = Astro.props;

const banCards = [
    {
        platform: "Instagram",
        icon: "/Elyt/images/socials/instagram.svg",
        bg: "#E4405F",
        title: "Account Suspended",
        message: "We detected automated behavior on your account.",
    },
    {
        platform: "LinkedIn",
        icon: "/Elyt/images/socials/linkedin.svg",
        bg: "#0A66C2",
        title: "Account Restricted",
        message: "Your account has been temporarily limited.",
    },
    {
        platform: "X",
        icon: "/Elyt/images/socials/x.svg",
        bg: "#000000",
        title: "Account Locked",
        message: "Unusual login activity detected on your account.",
    },
    {
        platform: "Facebook",
        icon: "/Elyt/images/socials/facebook.svg",
        bg: "#0866FF",
        title: "Action Blocked",
        message: "We limit how often you can do certain things.",
    },
];
---

<div class:list={["relative overflow-hidden bg-[#2d2568]", className]} {...rest}>
    <div class="absolute inset-0">

        <!-- Ban card 1: top-left, tilted -->
        <div class="absolute top-[8%] left-[10%] w-[52%] max-w-[220px] rotate-[-6deg] rounded-xl overflow-hidden border border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.5)]">
            <div class="h-6 bg-[#2a2450] flex items-center gap-1.5 px-2 border-b border-white/5">
                <div class="w-1.5 h-1.5 rounded-full bg-red-500/70"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-yellow-500/50"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-green-500/40"></div>
                <div class="flex items-center gap-1 ml-1.5 px-1.5 py-0.5 rounded bg-white/[0.06]">
                    <div class="w-3 h-3 rounded-sm flex-shrink-0 flex items-center justify-center" style={`background:${banCards[0].bg}`}>
                        <img src={banCards[0].icon} alt="" class="w-2 h-2 brightness-0 invert" loading="lazy" />
                    </div>
                    <span class="text-[6px] text-white/50 font-medium">{banCards[0].platform}</span>
                </div>
            </div>
            <div class="bg-[#1c1645] px-3 py-2.5">
                <div class="flex items-center gap-1.5 mb-1">
                    <div class="w-4 h-4 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-2.5 h-2.5 text-red-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
                    </div>
                    <span class="text-red-400 text-[8px] font-bold tracking-wide uppercase">{banCards[0].title}</span>
                </div>
                <p class="text-white/40 text-[6px] leading-relaxed">{banCards[0].message}</p>
            </div>
        </div>

        <!-- Ban card 2: top-right, tilted other way -->
        <div class="absolute top-[6%] right-[10%] w-[52%] max-w-[220px] rotate-[5deg] rounded-xl overflow-hidden border border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.5)]">
            <div class="h-6 bg-[#2a2450] flex items-center gap-1.5 px-2 border-b border-white/5">
                <div class="w-1.5 h-1.5 rounded-full bg-red-500/70"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-yellow-500/50"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-green-500/40"></div>
                <div class="flex items-center gap-1 ml-1.5 px-1.5 py-0.5 rounded bg-white/[0.06]">
                    <div class="w-3 h-3 rounded-sm flex-shrink-0 flex items-center justify-center" style={`background:${banCards[1].bg}`}>
                        <img src={banCards[1].icon} alt="" class="w-2 h-2 brightness-0 invert" loading="lazy" />
                    </div>
                    <span class="text-[6px] text-white/50 font-medium">{banCards[1].platform}</span>
                </div>
            </div>
            <div class="bg-[#1c1645] px-3 py-2.5">
                <div class="flex items-center gap-1.5 mb-1">
                    <div class="w-4 h-4 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-2.5 h-2.5 text-red-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
                    </div>
                    <span class="text-red-400 text-[8px] font-bold tracking-wide uppercase">{banCards[1].title}</span>
                </div>
                <p class="text-white/40 text-[6px] leading-relaxed">{banCards[1].message}</p>
            </div>
        </div>

        <!-- Ban card 3: bottom-left -->
        <div class="absolute bottom-[8%] left-[12%] w-[52%] max-w-[220px] rotate-[4deg] rounded-xl overflow-hidden border border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.5)]">
            <div class="h-6 bg-[#2a2450] flex items-center gap-1.5 px-2 border-b border-white/5">
                <div class="w-1.5 h-1.5 rounded-full bg-red-500/70"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-yellow-500/50"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-green-500/40"></div>
                <div class="flex items-center gap-1 ml-1.5 px-1.5 py-0.5 rounded bg-white/[0.06]">
                    <div class="w-3 h-3 rounded-sm flex-shrink-0 flex items-center justify-center" style={`background:${banCards[2].bg}`}>
                        <img src={banCards[2].icon} alt="" class="w-2 h-2 brightness-0 invert" loading="lazy" />
                    </div>
                    <span class="text-[6px] text-white/50 font-medium">{banCards[2].platform}</span>
                </div>
            </div>
            <div class="bg-[#1c1645] px-3 py-2.5">
                <div class="flex items-center gap-1.5 mb-1">
                    <div class="w-4 h-4 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-2.5 h-2.5 text-red-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
                    </div>
                    <span class="text-red-400 text-[8px] font-bold tracking-wide uppercase">{banCards[2].title}</span>
                </div>
                <p class="text-white/40 text-[6px] leading-relaxed">{banCards[2].message}</p>
            </div>
        </div>

        <!-- Ban card 4: bottom-right -->
        <div class="absolute bottom-[6%] right-[10%] w-[52%] max-w-[220px] rotate-[-3deg] rounded-xl overflow-hidden border border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.5)]">
            <div class="h-6 bg-[#2a2450] flex items-center gap-1.5 px-2 border-b border-white/5">
                <div class="w-1.5 h-1.5 rounded-full bg-red-500/70"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-yellow-500/50"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-green-500/40"></div>
                <div class="flex items-center gap-1 ml-1.5 px-1.5 py-0.5 rounded bg-white/[0.06]">
                    <div class="w-3 h-3 rounded-sm flex-shrink-0 flex items-center justify-center" style={`background:${banCards[3].bg}`}>
                        <img src={banCards[3].icon} alt="" class="w-2 h-2 brightness-0 invert" loading="lazy" />
                    </div>
                    <span class="text-[6px] text-white/50 font-medium">{banCards[3].platform}</span>
                </div>
            </div>
            <div class="bg-[#1c1645] px-3 py-2.5">
                <div class="flex items-center gap-1.5 mb-1">
                    <div class="w-4 h-4 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-2.5 h-2.5 text-red-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
                    </div>
                    <span class="text-red-400 text-[8px] font-bold tracking-wide uppercase">{banCards[3].title}</span>
                </div>
                <p class="text-white/40 text-[6px] leading-relaxed">{banCards[3].message}</p>
            </div>
        </div>

        <!-- Ban card 5: center-left -->
        <div class="absolute top-1/2 -translate-y-1/2 left-[3%] w-[48%] max-w-[200px] rotate-[3deg] rounded-xl overflow-hidden border border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.5)]">
            <div class="h-6 bg-[#2a2450] flex items-center gap-1.5 px-2 border-b border-white/5">
                <div class="w-1.5 h-1.5 rounded-full bg-red-500/70"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-yellow-500/50"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-green-500/40"></div>
                <div class="flex items-center gap-1 ml-1.5 px-1.5 py-0.5 rounded bg-white/[0.06]">
                    <div class="w-3 h-3 rounded-sm flex-shrink-0 flex items-center justify-center bg-[#FF0000]">
                        <img src="/Elyt/images/socials/youtube.svg" alt="" class="w-2 h-2 brightness-0 invert" loading="lazy" />
                    </div>
                    <span class="text-[6px] text-white/50 font-medium">YouTube</span>
                </div>
            </div>
            <div class="bg-[#1c1645] px-3 py-2.5">
                <div class="flex items-center gap-1.5 mb-1">
                    <div class="w-4 h-4 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-2.5 h-2.5 text-red-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
                    </div>
                    <span class="text-red-400 text-[8px] font-bold tracking-wide uppercase">Channel Terminated</span>
                </div>
                <p class="text-white/40 text-[6px] leading-relaxed">Repeated violations of our Terms of Service.</p>
            </div>
        </div>

        <!-- Ban card 6: center-right -->
        <div class="absolute top-1/2 -translate-y-1/2 right-[3%] w-[48%] max-w-[200px] rotate-[-4deg] rounded-xl overflow-hidden border border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.5)]">
            <div class="h-6 bg-[#2a2450] flex items-center gap-1.5 px-2 border-b border-white/5">
                <div class="w-1.5 h-1.5 rounded-full bg-red-500/70"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-yellow-500/50"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-green-500/40"></div>
                <div class="flex items-center gap-1 ml-1.5 px-1.5 py-0.5 rounded bg-white/[0.06]">
                    <div class="w-3 h-3 rounded-sm flex-shrink-0 flex items-center justify-center bg-black">
                        <img src="/Elyt/images/socials/tiktok.svg" alt="" class="w-2 h-2 brightness-0 invert" loading="lazy" />
                    </div>
                    <span class="text-[6px] text-white/50 font-medium">TikTok</span>
                </div>
            </div>
            <div class="bg-[#1c1645] px-3 py-2.5">
                <div class="flex items-center gap-1.5 mb-1">
                    <div class="w-4 h-4 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-2.5 h-2.5 text-red-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
                    </div>
                    <span class="text-red-400 text-[8px] font-bold tracking-wide uppercase">Account Banned</span>
                </div>
                <p class="text-white/40 text-[6px] leading-relaxed">Suspicious activity detected on your account.</p>
            </div>
        </div>

        <!-- Central CAPTCHA — on top of everything -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-[54%] max-w-[215px] rounded-xl overflow-hidden border-2 border-red-500/30 shadow-[0_0_50px_rgba(239,68,68,0.12),0_20px_60px_rgba(0,0,0,0.6)]">
            <div class="h-7 bg-[#2a2450] flex items-center gap-1.5 px-2.5 border-b border-white/5">
                <div class="w-2 h-2 rounded-full bg-red-500/70"></div>
                <div class="w-2 h-2 rounded-full bg-yellow-500/50"></div>
                <div class="w-2 h-2 rounded-full bg-green-500/40"></div>
                <div class="h-3.5 flex-1 ml-2 rounded bg-white/[0.06]"></div>
            </div>
            <div class="bg-white px-4 py-4 flex flex-col items-center gap-2">
                <div class="w-9 h-9 rounded-full bg-red-50 flex items-center justify-center">
                    <svg class="w-5 h-5 text-red-500" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1.07A7.001 7.001 0 0 1 7.07 19H6a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h-1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2zM7.5 13a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm9 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z" />
                    </svg>
                </div>
                <span class="text-gray-900 text-[9px] font-bold text-center">Verify you are human</span>
                <div class="w-full h-6 rounded-md border-2 border-gray-200 flex items-center gap-1.5 px-2">
                    <div class="w-3.5 h-3.5 rounded border-2 border-gray-300 flex-shrink-0"></div>
                    <span class="text-gray-500 text-[7px]">I'm not a robot</span>
                </div>
            </div>
        </div>

    </div>
</div>
