---
const { class: className, ...rest } = Astro.props;

const queuedTasks = [
    { platform: "LinkedIn", icon: "/Elyt/images/socials/linkedin.svg", bg: "#0A66C2", task: "Send 50 connection requests" },
    { platform: "Instagram", icon: "/Elyt/images/socials/instagram.svg", bg: "#E4405F", task: "Post carousel to 12 profiles" },
    { platform: "X", icon: "/Elyt/images/socials/x.svg", bg: "#000000", task: "Reply to DMs on 8 accounts" },
];
---

<div class:list={["relative overflow-hidden bg-[#2d2568]", className]} {...rest}>
    <div class="absolute inset-0 flex items-center justify-center p-4">

        <!-- Single task manager window -->
        <div class="w-full max-w-[380px] rounded-2xl overflow-hidden border border-white/15 shadow-[0_12px_50px_rgba(0,0,0,0.5)]">
            <!-- Title bar -->
            <div class="h-8 bg-[#252050] flex items-center gap-1.5 px-3 border-b border-white/5">
                <div class="w-2 h-2 rounded-full bg-red-500/60"></div>
                <div class="w-2 h-2 rounded-full bg-white/20"></div>
                <div class="w-2 h-2 rounded-full bg-white/15"></div>
                <span class="text-[8px] text-white/40 ml-2 font-medium">Task Queue</span>
            </div>

            <div class="bg-[#16133a] rounded-b-2xl">
                <!-- ACTIVE TASK — highlighted row -->
                <div class="px-4 py-3 border-b border-white/[0.06] bg-indigo-500/[0.08] border-l-2 border-l-indigo-400">
                    <div class="flex items-center gap-2.5">
                        <div class="w-6 h-6 rounded-sm flex-shrink-0 flex items-center justify-center bg-[#FF0000]">
                            <img src="/Elyt/images/socials/youtube.svg" alt="" class="w-3.5 h-3.5 brightness-0 invert" loading="lazy" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between">
                                <span class="text-[9px] text-white/80 font-semibold">Upload video to profile #1</span>
                                <div class="flex items-center gap-1 flex-shrink-0 ml-2">
                                    <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div>
                                    <span class="text-[8px] text-green-400/80 font-medium">Running</span>
                                </div>
                            </div>
                            <!-- Progress bar -->
                            <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden mt-1.5">
                                <div class="h-full w-[35%] rounded-full bg-gradient-to-r from-indigo-500 to-purple-500"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- QUEUED TASKS — greyed out, each with a paused icon -->
                {queuedTasks.map((task, i) => (
                    <div class:list={[
                        "px-4 py-2.5 border-b border-white/[0.04] flex items-center gap-2.5",
                        i >= 2 ? "opacity-30" : "opacity-50"
                    ]}>
                        <div class="w-6 h-6 rounded-sm flex-shrink-0 flex items-center justify-center" style={`background:${task.bg}`}>
                            <img src={task.icon} alt="" class="w-3.5 h-3.5 brightness-0 invert" loading="lazy" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <span class="text-[8px] text-white/40 font-medium truncate block">{task.task}</span>
                        </div>
                        <!-- Paused icon -->
                        <div class="flex items-center gap-1 flex-shrink-0">
                            <svg class="w-3 h-3 text-white/20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                            <span class="text-[7px] text-white/20 font-medium">Paused</span>
                        </div>
                    </div>
                ))}

                <!-- Footer — error banner -->
                <div class="mx-3 my-2 px-2.5 py-2 rounded-lg bg-red-500/10 border border-red-500/20 flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-red-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                    <span class="text-[8px] text-red-400 font-bold">No parallel execution supported</span>
                </div>
            </div>
        </div>

    </div>
</div>
